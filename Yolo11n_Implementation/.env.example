# ---- Frontend ----
REACT_APP_API_BASE=http://127.0.0.1:8000
REACT_APP_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# ---- Backend: AI pipeline ----
# Where traffic_pipeline/ + traffic_control/ + configs/runtime.yaml live.
# Defaults to ./traffic, so you normally do not need to set this.
# TRAFFIC_AI_DIR=

# Video the dashboard analyses by default. If unset, the backend picks the first
# .mp4 it finds in ./samples, then the project root, then ~/Downloads.
# TRAFFIC_DEFAULT_VIDEO_PATH=

# Detector backend: "local" runs the bundled YOLO weights (default),
# "sagemaker" calls a remote endpoint. The trained DQN always runs locally.
TRAFFIC_INFERENCE_PROVIDER=local

# ---- Optional: SageMaker detector (only when provider=sagemaker) ----
# Requires: pip install -r backend/requirements-cloud.txt
# SAGEMAKER_ENDPOINT_NAME=traffic-yolo-realtime
# AWS_REGION=ap-south-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ---- Optional: archive analysis events to S3 ----
# TRAFFIC_S3_BUCKET=
# TRAFFIC_S3_PREFIX=traffic-analytics/events

# ---- Map placement for the dashboard's lane nodes ----
TRAFFIC_CAMERA_ID=camera-001
TRAFFIC_NODE_CENTER_LAT=17.385
TRAFFIC_NODE_CENTER_LNG=78.4867
